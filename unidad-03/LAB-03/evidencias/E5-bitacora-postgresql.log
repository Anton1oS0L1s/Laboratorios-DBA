2026-11-26 21:27:04.589 CST [5348] user=postgres db=db_23101954_marco_solis app=pgAdmin 4 - CONN:3470587 client=::1 LOG:  sentencia: CREATE VIEW v_clientes_soporte AS
	SELECT
	    id,
	    nombre,
	
	    CONCAT(
	        LEFT(correo, 2),
	        '*****',
	        SUBSTRING(correo FROM POSITION('@' IN correo))
	    ) AS correo,
	
	    CONCAT(
	        '******',
	        RIGHT(telefono, 4)
	    ) AS telefono,
	
	    CONCAT(
	        '*********',
	        RIGHT(rfc, 4)
	    ) AS rfc
	
	FROM clientes;
